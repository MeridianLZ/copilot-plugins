COPILOT_TRACE_BRIDGE_HOST=0.0.0.0
COPILOT_TRACE_BRIDGE_PORT=14329
COPILOT_TRACE_BRIDGE_URL=http://127.0.0.1:14329/hooks
COPILOT_TRACE_DATA_DIR=.copilot/telemetry
COPILOT_TRACE_CONTENT_MODE=hash
COPILOT_TRACE_CONTENT_MAX_BYTES=32768
COPILOT_TRACE_POST_TIMEOUT_MS=250
COPILOT_TRACE_OPEN_SPAN_TIMEOUT_MS=1800000
COPILOT_TRACE_SPOOL_DRAIN_INTERVAL_MS=2000
COPILOT_TRACE_CONSOLE_MODE=pretty
# Payload-identity dedupe window (multiple hook installs fire ~600ms apart)
COPILOT_TRACE_DEDUPE_WINDOW_MS=10000
# Copilot home override; conversation replica reads session-state/<id>/events.jsonl from here
# COPILOT_HOME=C:\Users\me\.copilot
# Host-published OTel Collector ports (non-standard to avoid collisions with
# other local stacks; 4317/4318 and 14317/14318 are already claimed on dev boxes).
OTEL_COLLECTOR_GRPC_PORT=27431
OTEL_COLLECTOR_HTTP_PORT=27432
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:27432/v1/traces
OTEL_SERVICE_NAME=copilot-hook-bridge
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.namespace=agent-observability

# Native GitHub Copilot CLI OTel lane (set in the shell that starts `copilot`)
COPILOT_OTEL_ENABLED=true
COPILOT_OTEL_EXPORTER_TYPE=otlp-http
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:27432
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
COPILOT_OTEL_SOURCE_NAME=copilot
OTEL_SERVICE_NAME=copilot
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
# Alternative native JSONL lane:
# COPILOT_OTEL_EXPORTER_TYPE=file
# COPILOT_OTEL_FILE_EXPORTER_PATH=.copilot/telemetry/native-otel.jsonl
