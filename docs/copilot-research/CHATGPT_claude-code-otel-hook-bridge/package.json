{
  "name": "claude-code-otel-hook-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Claude Code hook JSONL egress, live tail, and OpenTelemetry trace bridge",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/bridge.ts",
    "start": "node dist/src/bridge.js",
    "hook": "node dist/src/hook-egress.js",
    "tail": "tsx src/tail.ts",
    "hooks:generate": "tsx src/generate-hooks.ts",
    "hooks:apply": "tsx src/generate-hooks.ts --apply",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.22.4",
    "typescript": "6.0.0"
  }
}
