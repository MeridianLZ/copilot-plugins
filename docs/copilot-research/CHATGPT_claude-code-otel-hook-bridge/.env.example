TRACE_BRIDGE_HOST=0.0.0.0
TRACE_BRIDGE_PORT=4319
TRACE_BRIDGE_URL=http://127.0.0.1:4319/hooks
TRACE_DATA_DIR=.claude/telemetry
TRACE_CONTENT_MODE=hash
TRACE_CONTENT_MAX_BYTES=32768
TRACE_POST_TIMEOUT_MS=250
TRACE_OPEN_SPAN_TIMEOUT_MS=1800000
TRACE_SPOOL_DRAIN_INTERVAL_MS=2000
TRACE_CONSOLE_MODE=pretty
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_SERVICE_NAME=claude-code-hook-bridge
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.namespace=agent-observability
