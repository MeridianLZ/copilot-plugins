{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "./scripts/session-blackboard-init.sh",
        "cwd": "${PLUGIN_ROOT}/hooks",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "./scripts/preflight-guard.sh",
        "cwd": "${PLUGIN_ROOT}/hooks",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "./scripts/blackboard-append-tool.sh",
        "cwd": "${PLUGIN_ROOT}/hooks",
        "timeoutSec": 10
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "./scripts/blackboard-append-tool.sh --event error",
        "cwd": "${PLUGIN_ROOT}/hooks",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "./scripts/session-blackboard-close.sh",
        "cwd": "${PLUGIN_ROOT}/hooks",
        "timeoutSec": 10
      }
    ]
  }
}
