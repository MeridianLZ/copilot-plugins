{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "./scripts/session-banner.sh",
        "powershell": "./scripts/session-banner.ps1",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "./scripts/guard-core.sh --dialect copilot",
        "powershell": "./scripts/guard-core.ps1",
        "cwd": ".github/hooks",
        "timeoutSec": 15
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "./scripts/audit-log.sh",
        "powershell": "./scripts/audit-log.ps1",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "./scripts/audit-log.sh --event error",
        "powershell": "./scripts/audit-log.ps1 -Event error",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      }
    ]
  }
}
