# copilot-mcp config SSoT — copy to .env and adjust. No hardcoded duplicates:
# every consumer (transports, test-client) reads these via src/config.ts.

# Loopback binding; the HTTP port also carries the WebSocket upgrade (same /mcp endpoint).
COPILOT_MCP_HOST=127.0.0.1
COPILOT_MCP_HTTP_PORT=27443

# Permission policy for the wrapped Copilot agent: readonly | approve-all
COPILOT_MCP_PERMISSIONS=readonly

# Default model for new sessions (blank = CLI default)
COPILOT_MCP_MODEL=

# Attach to an external `copilot --headless --port N` instead of spawning (host:port)
COPILOT_MCP_CLI_URL=

# Hard ceiling for a single ask turn
COPILOT_MCP_ASK_TIMEOUT_MS=300000
